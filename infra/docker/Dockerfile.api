FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend/src:/app/backend
ENV PIP_DEFAULT_TIMEOUT=180
ENV PIP_RETRIES=10
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements-api.txt ./

RUN python -m pip install \
    --no-cache-dir \
    --index-url https://pypi.org/simple \
    --timeout 180 \
    --retries 10 \
    -r requirements-api.txt

COPY backend/api ./backend/api
COPY backend/persistence ./backend/persistence
COPY backend/src ./backend/src
COPY models/*.joblib ./models/
COPY reports/evaluation_results.json ./reports/evaluation_results.json
COPY artifacts/graph/graph_summary.json ./artifacts/graph/graph_summary.json
EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]